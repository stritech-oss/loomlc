# Build output
/dist/
/bin/
*.exe

# Go
/vendor/
*.test
*.out

# loomlc runtime state / local config
/.loomlc/
*.log

# Secrets: never commit tokens or keys. Match secret file types, not words in file names,
# so source files such as token.go aren't silently ignored.
.env
.env.*
*.env
*.pem
*.key
*.p12
*.pfx
*.token
!*.example

# Personal agent config — never shared
CLAUDE.local.md
.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/
